#!/usr/bin/env bash
# Short launcher: open the voicebox window
set -euo pipefail
# if vo is a symlink, resolve to the real script path
SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE" ]]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
ROOT="$(cd -P "$(dirname "$SOURCE")" && pwd)"
exec "$ROOT/.venv/bin/python" "$ROOT/voicebox.py" "$@"
