#!/usr/bin/env bash
# Короткая команда: открыть меню voicebox
set -euo pipefail
# если vo — симлинк, берём реальный путь к скрипту
SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE" ]]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
ROOT="$(cd -P "$(dirname "$SOURCE")" && pwd)"
exec "$ROOT/.venv/bin/python" "$ROOT/voicebox.py" "$@"
